{
  "name": "familytree",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @ft/web",
    "build": "npm run build --workspace @ft/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p packages/domain && tsc --noEmit -p packages/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "vitest run apps/web/src/api/mock-db.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
